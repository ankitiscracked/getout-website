{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getout-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "R2_BUCKET": "getout-releases",
    "R2_ACCOUNT_ID": "9cadae6cf1a3fa582564337a82bb3861"
  }
}
