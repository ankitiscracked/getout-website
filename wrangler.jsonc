{
  "name": "getout-website",
  "type": "javascript",
  "main": "dist/index.js",
  "compatibility_date": "2024-11-12",
  // Update this with your domain
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "example.com/*",
          "zone_name": "example.com"
        }
      ]
    }
  },
  "build": {
    "upload": [
      {
        "format": "service-worker"
      }
    ]
  }
}
